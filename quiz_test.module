<?php

/**
 * @file
 * Primary module hooks for the Quiz Test module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;

/**
 * Implements hook_help().
 */
function quiz_test_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.quiz_test':
      $output = '';
      $output .= '<h3>' . t('О модуле') . '</h3>';
      $output .= '<p>' . t('Модуль «Тестирование» позволяет создавать и управлять тестами на вашем сайте. Администраторы могут создавать тесты с вопросами с несколькими вариантами ответов, а пользователи с соответствующей ролью могут проходить тесты.') . '</p>';
      $output .= '<h3>' . t('Использование') . '</h3>';
      $output .= '<dl>';
      $output .= '<dt>' . t('Управление тестами') . '</dt>';
      $output .= '<dd>' . t('Перейдите в <a href=":tests">Администрирование » Содержимое » Тесты</a> для создания, редактирования и удаления тестов. Каждый тест может иметь название, описание и получателей email для уведомлений о результатах.', [':tests' => '/admin/quiz-test']) . '</dd>';
      $output .= '<dt>' . t('Управление вопросами') . '</dt>';
      $output .= '<dd>' . t('После создания теста нажмите «Редактировать», а затем перейдите на вкладку «Вопросы», чтобы добавить, отредактировать или удалить вопросы с вариантами ответа. Каждый вопрос может иметь неограниченное количество вариантов ответа, один из которых является верным.', []) . '</dd>';
      $output .= '<dt>' . t('Открытые вопросы') . '</dt>';
      $output .= '<dd>' . t('На вкладке «Открытые вопросы» можно добавить вторую, опциональную часть теста — открытые вопросы со свободным ответом. Эта часть появляется в форме прохождения и в письме с результатами только при наличии хотя бы одного открытого вопроса. Открытые ответы не влияют на процентный балл.', []) . '</dd>';
      $output .= '<dt>' . t('Настройки') . '</dt>';
      $output .= '<dd>' . t('Перейдите на <a href=":settings">Администрирование » Конфигурация » Настройки тестирования</a>, чтобы указать роль для доступа к тестам и параметры email-уведомлений.', [':settings' => '/admin/config/quiz-test/settings']) . '</dd>';
      $output .= '<dt>' . t('Ежедневный отчёт') . '</dt>';
      $output .= '<dd>' . t('Перейдите на <a href=":report">Администрирование » Конфигурация » Ежедневный отчёт</a> для настройки автоматической рассылки сводки за день по электронной почте.', [':report' => '/admin/config/quiz-test/daily-report']) . '</dd>';
      $output .= '<dt>' . t('Прохождение тестов') . '</dt>';
      $output .= '<dd>' . t('Пользователи с назначенной ролью могут проходить тесты по адресу <em>/quiz-test/{test-id}</em>. После отправки ответов результаты будут отправлены на настроенные адреса электронной почты и сохранены в журнале <a href=":results">Результаты тестирования</a>.', [':results' => '/admin/quiz-test/results']) . '</dd>';
      $output .= '</dl>';
      return $output;

    case 'entity.quiz_test.collection':
      return '<p>' . t('Управление тестами. Нажмите «Добавить тест», чтобы создать новый тест, или используйте ссылки в столбце «Операции» для редактирования, удаления и управления вопросами. На вкладке «Результаты» — журнал прохождений: кто, когда и какой тест проходил.') . '</p>';

    case 'quiz_test.results':
      return '<p>' . t('Журнал прохождений тестов. Нажмите «Результаты» в строке, чтобы увидеть детальный отчёт — ответы пользователя по каждому вопросу. Используйте фильтр, чтобы отобрать результаты по тесту или ФИО.') . '</p>';

    case 'quiz_test.settings':
      return '<p>' . t('Настройки модуля «Тестирование». Укажите роль, которой разрешено проходить тесты, и параметры email-уведомлений о результатах.') . '</p>';

    case 'quiz_test.daily_report_settings':
      return '<p>' . t('Настройки автоматической рассылки сводного отчёта по тестированию за день. Укажите email-адреса получателей и время отправки в конце дня.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function quiz_test_theme($existing, $type, $theme, $path) {
  return [
    'quiz_test_results_email' => [
      'variables' => [
        'test' => NULL,
        'user' => NULL,
        'full_name' => '',
        'date' => '',
        'correct' => 0,
        'total' => 0,
        'score_percent' => 0,
        'questions' => [],
        'open_questions' => [],
        'has_score' => TRUE,
      ],
      'template' => 'quiz-test-results-email',
    ],
    'quiz_test_daily_report_email' => [
      'variables' => [
        'report' => [],
        'subject' => '',
        'include_details' => TRUE,
        'site_name' => '',
        'is_web_view' => FALSE,
      ],
      'template' => 'quiz-test-daily-report-email',
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function quiz_test_mail($key, &$message, $params) {
  switch ($key) {
    case 'quiz_test_results':
      /** @var \Drupal\quiz_test\Entity\QuizTest $test */
      $test = $params['test'];
      /** @var \Drupal\user\UserInterface $user */
      $user = $params['user'];

      $message['subject'] = $params['subject'];
      $message['from'] = \Drupal::config('system.site')->get('mail');

      // Build the HTML email body using the template.
      $html_content = [
        '#theme' => 'quiz_test_results_email',
        '#test' => [
          'label' => $test->label(),
        ],
        '#user' => [
          'display_name' => $user->getDisplayName(),
        ],
        '#full_name' => $params['full_name'] ?? '',
        '#date' => \Drupal::service('date.formatter')->format(\Drupal::time()->getRequestTime(), 'long'),
        '#correct' => $params['correct'],
        '#total' => $params['total'],
        '#score_percent' => $params['score_percent'],
        '#questions' => $params['questions'],
        '#open_questions' => $params['open_questions'] ?? [],
        '#has_score' => $params['has_score'] ?? TRUE,
      ];
      $rendered_html = (string) \Drupal::service('renderer')->renderPlain($html_content);

      // Set the HTML body and flag it as HTML.
      $message['body'][] = $rendered_html;
      $message['params']['html'] = TRUE;
      break;

    case 'daily_report':
      $message['subject'] = $params['subject'];
      $message['from'] = \Drupal::config('system.site')->get('mail');

      $html_content = [
        '#theme' => 'quiz_test_daily_report_email',
        '#report' => $params['report'],
        '#subject' => $params['subject'],
        '#include_details' => $params['include_details'] ?? TRUE,
        '#site_name' => $params['site_name'] ?? \Drupal::config('system.site')->get('name'),
        '#is_web_view' => FALSE,
      ];
      $rendered_html = (string) \Drupal::service('renderer')->renderPlain($html_content);

      $message['body'][] = $rendered_html;
      $message['params']['html'] = TRUE;
      break;
  }
}

/**
 * Implements hook_mail_alter().
 *
 * Drupal core's MailManager::doMail() sets Content-Type to text/plain AFTER
 * hook_mail() runs, so we must override it here. This follows the same
 * pattern as the Webform module.
 *
 * @see https://www.drupal.org/project/webform
 */
function quiz_test_mail_alter(&$message) {
  // Only alter emails sent by the quiz_test module.
  if (strpos($message['id'], 'quiz_test') === 0) {
    if (!empty($message['params']['html'])) {
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
    }
  }
}

/**
 * Implements hook_cron().
 *
 * Checks if the daily report should be sent at the end of the day.
 */
function quiz_test_cron() {
  $config = \Drupal::config('quiz_test.daily_report.settings');
  if (!$config->get('enabled')) {
    return;
  }

  $recipients = trim((string) $config->get('recipients'));
  if (empty($recipients)) {
    return;
  }

  // Get current time in the site timezone.
  $timezone = \Drupal::config('system.date')->get('timezone.default') ?: date_default_timezone_get();
  try {
    $now = new \DateTime('now', new \DateTimeZone($timezone));
  }
  catch (\Exception $e) {
    return;
  }

  // Check weekdays only condition (1 = Monday, 7 = Sunday).
  if ($config->get('weekdays_only')) {
    $day_of_week = (int) $now->format('N');
    if ($day_of_week > 5) {
      return;
    }
  }

  // Check if current hour has reached the configured send hour.
  $send_hour = $config->get('send_hour') !== NULL ? (int) $config->get('send_hour') : 20;
  $current_hour = (int) $now->format('G');
  if ($current_hour < $send_hour) {
    return;
  }

  // Check if report has already been sent today.
  $today_str = $now->format('Y-m-d');
  $last_sent = (string) $config->get('last_sent_date');
  if ($last_sent === $today_str) {
    return;
  }

  // Dispatch daily report.
  try {
    /** @var \Drupal\quiz_test\Service\QuizTestDailyReportService $report_service */
    $report_service = \Drupal::service('quiz_test.daily_report');
    $report_service->sendDailyReport($now);
  }
  catch (\Exception $e) {
    \Drupal::logger('quiz_test')->error('Ошибка при автоматической отправке ежедневного отчёта в Cron: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
}

/**
 * Implements hook_entity_type_build().
 */
function quiz_test_entity_type_build(array &$entity_types) {
  // Add the list_builder class for QuizTest entity.
  if (isset($entity_types['quiz_test'])) {
    $entity_types['quiz_test']->setListBuilderClass('Drupal\quiz_test\Form\QuizTestListBuilder');
  }
}

/**
 * Implements hook_entity_insert().
 */
function quiz_test_entity_insert($entity) {
  if ($entity->getEntityTypeId() === 'quiz_test') {
    \Drupal::logger('quiz_test')->notice('Создан тест «@title».', [
      '@title' => $entity->label(),
    ]);
  }
  if ($entity->getEntityTypeId() === 'quiz_test_question') {
    \Drupal::logger('quiz_test')->notice('Добавлен вопрос к тесту ID @test_id.', [
      '@test_id' => $entity->getTestId(),
    ]);
  }
}

/**
 * Implements hook_entity_delete().
 */
function quiz_test_entity_delete($entity) {
  if ($entity->getEntityTypeId() === 'quiz_test') {
    // Cascade: remove the submission log entries of the deleted test.
    try {
      $storage = \Drupal::entityTypeManager()->getStorage('quiz_test_result');
      $ids = $storage->getQuery()
        ->condition('test_id', $entity->id())
        ->accessCheck(TRUE)
        ->execute();
      if (!empty($ids)) {
        $storage->delete($storage->loadMultiple($ids));
      }
    }
    catch (\Exception $e) {
      \Drupal::logger('quiz_test')->warning('Не удалось удалить журнал прохождений теста ID @id: @message', [
        '@id' => $entity->id(),
        '@message' => $e->getMessage(),
      ]);
    }

    \Drupal::logger('quiz_test')->notice('Удалён тест «@title».', [
      '@title' => $entity->label(),
    ]);
  }
}

/**
 * Implements hook_entity_view_display_alter().
 *
 * Removes unwanted fields from entity view displays.
 */
function quiz_test_entity_view_display_alter(EntityViewDisplayInterface $display, array $context) {
  if ($context['entity_type'] === 'quiz_test') {
    $display->removeComponent('description');
    $display->removeComponent('uid');
    $display->removeComponent('email_recipients');
    $display->removeComponent('email_subject');
    $display->removeComponent('status');
  }
}

/**
 * Implements hook_entity_view().
 *
 * Ensures unwanted fields are never shown in entity views.
 */
function quiz_test_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  if ($entity->getEntityTypeId() === 'quiz_test') {
    unset($build['description']);
    unset($build['uid']);
    unset($build['email_recipients']);
    unset($build['email_subject']);
    unset($build['status']);
  }
}

/**
 * Prepares variables for quiz test results email templates.
 *
 * Default template: quiz-test-results-email.html.twig.
 */
function template_preprocess_quiz_test_results_email(&$variables) {
  $variables['test_label'] = isset($variables['test']['label']) ? $variables['test']['label'] : '';
  $variables['user_display_name'] = isset($variables['user']['display_name']) ? $variables['user']['display_name'] : '';
  $variables['full_name'] = $variables['full_name'] ?? '';
  $variables['date'] = $variables['date'] ?? '';
  $variables['correct'] = $variables['correct'] ?? 0;
  $variables['total'] = $variables['total'] ?? 0;
  $variables['score_percent'] = $variables['score_percent'] ?? 0;
  $variables['questions'] = $variables['questions'] ?? [];
  $variables['open_questions'] = $variables['open_questions'] ?? [];
  $variables['has_score'] = $variables['has_score'] ?? TRUE;
}
